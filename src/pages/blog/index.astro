---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
---

<html>
  <body>
    <h1>Daftar Blog</h1>
    <ul>
      {allPosts.map((post) => (
        <li>
          <a href={`/blog/${post.slug}`}>{post.data.title}</a> - {post.data.pubDate.toDateString()}
        </li>
      ))}
    </ul>
  </body>
</html>
