---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = await getCollection('blog');
---

<Layout title="Blog">
  <h1 class="text-3xl font-bold mb-6">Daftar Postingan</h1>
  <ul>
    {posts.map((post) => (
      <li class="mb-4">
        <a href={`/page/blog/${post.id}`} class="text-blue-600 hover:underline text-xl">
          {post.data.title}
        </a>
        <p class="text-gray-600">{post.data.description}</p>
      </li>
    ))}
  </ul>
</Layout>
