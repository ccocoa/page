---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
---

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Page</title>
</head>
<body>
    <h1>Daftar Blog</h1>
    <ul>
      {allPosts.map((post) => (
        <li>
          <a href={`${import.meta.env.BASE_URL}/blog/${post.slug}`}>{post.data.title}</a> - {post.data.pubDate.toDateString()}
        </li>
      ))}
    </ul>
</body>
</html>
